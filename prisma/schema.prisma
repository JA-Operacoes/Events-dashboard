// Schema — banco de teste no Neon, enquanto a API oficial não existe.
// Eventos/edições são cadastrados aqui manualmente por enquanto (o admin
// registra pelo painel). `idEventoExterno` fica reservado pra quando a API
// oficial do sistema deles existir e a gente quiser linkar pelo ID de lá —
// não é usado ainda.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon recomenda uma URL separada, sem pgbouncer, para migrations.
  directUrl = env("DIRECT_URL")
}

/// admin: acesso total (inclui gerenciar eventos/edições/usuários).
/// funcionario: nível intermediário — mexe nos dados das edições que tem
/// acesso (importar planilha, sincronizar, editar KPI manual) mas não entra
/// em /admin/eventos nem /admin/usuarios.
/// usuario: só visualiza as edições que tem acesso, sem mexer em nada.
enum UserRole {
  admin
  funcionario
  usuario
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(usuario)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  editionAccess  UserEditionAccess[]
  passwordResets PasswordResetToken[]

  @@map("users")
}

/// Cadastro próprio de eventos — até a API oficial existir, é o admin quem
/// registra aqui pelo painel.
model Event {
  id              String   @id @default(cuid())
  nome            String
  /// Agrupa sub-eventos do mesmo cliente/marca (ex.: "Beauty Fair" agrupa Beauty BH,
  /// Beauty Show, Professional Fair RJ/BH) — puramente organizacional, cada evento
  /// dentro do grupo continua com edições/marca/acesso configurados individualmente.
  grupo           String?
  /// Reservado para o dia em que a API oficial existir e precisarmos linkar
  /// pelo ID deles (ex.: 171 = "A I & DATA"). Não usado ainda.
  idEventoExterno Int?     @unique
  /// Marca própria do evento (multi-tenant) — quando definida, substitui a
  /// logo padrão do Portal JA na sidebar enquanto esse evento está selecionado.
  logoUrl         String?
  /// Alguns eventos contratados não querem nenhuma referência visível à
  /// empresa contratada (Portal JA) — liga isso pra esconder completamente.
  hideBranding    Boolean  @default(false)
  /// Cor primária (hex, ex.: "#e53939") pra deixar a cara do cliente —
  /// substitui a cor de destaque padrão do tema enquanto esse evento está
  /// selecionado. Nulo = usa a cor padrão do template.
  accentColor     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  editions Edition[]

  @@map("events")
}

/// Uma edição/ano de um evento (ex.: SetExpo 2025, SetExpo 2026).
model Edition {
  id                  String   @id @default(cuid())
  eventId             String
  ano                 Int
  label               String
  bannerUrl           String?
  showTitleOverBanner Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  importedInvoices      ImportedInvoice[]
  importedParticipantes ImportedParticipante[]
  access                UserEditionAccess[]

  @@unique([eventId, ano])
  @@map("editions")
}

/// Duplicata vinda do "modo planilha" — persistida pra não precisar reimportar
/// toda vez que alguém abre o dashboard. `sourceFile` identifica de qual
/// arquivo a linha veio; reimportar o mesmo arquivo substitui só as linhas
/// dele (ver rota /api/financeiro/import).
model ImportedInvoice {
  id         String   @id @default(cuid())
  editionId  String
  sourceFile String
  numero     String
  cliente    String
  cnpj       String
  vencimento String
  pagamento  String?
  forma      String
  valor      Float
  status     String
  /// Rateio de contas/centro de custo — opcionais, algumas planilhas de ERP trazem até 4 por duplicata.
  centroCusto String?
  conta1     String?
  conta2     String?
  conta3     String?
  createdAt  DateTime @default(now())

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId])
  @@index([editionId, sourceFile])
  @@map("imported_invoices")
}

/// Participante de credenciamento vindo do "modo planilha" — mesmo esquema
/// de persistência do ImportedInvoice.
model ImportedParticipante {
  id            String   @id @default(cuid())
  editionId     String
  sourceFile    String
  nome          String
  documento     String
  categoria     String
  credenciadoEm String?
  checkinEm     String?
  status        String
  createdAt     DateTime @default(now())

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId])
  @@index([editionId, sourceFile])
  @@map("imported_participantes")
}

/// Vínculo usuário → edição específica (não o evento inteiro) — dar acesso só
/// ao evento confundia quem via edições antigas/irrelevantes do mesmo evento
/// misturadas às atuais. Um usuário pode ter vínculo com várias edições de
/// vários eventos; admins enxergam tudo independente de vínculo (`isAdmin`).
model UserEditionAccess {
  id        String   @id @default(cuid())
  userId    String
  editionId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([userId, editionId])
  @@map("user_edition_access")
}

/// Token de uso único para o fluxo de "esqueci minha senha".
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Registro de tentativa de login mal-sucedida — usado pro rate limit em
/// /api/auth/login. Persistido no banco (não em memória) porque a app roda
/// serverless na Vercel: cada invocação pode cair numa instância diferente,
/// então um contador em memória não pegaria tentativas espalhadas entre elas.
/// Linhas velhas (fora da janela de rate limit) são só ignoradas na consulta —
/// não precisam de limpeza ativa, o volume é baixo.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@map("login_attempts")
}
